+    const dispose = vi.spyOn(Skeleton.prototype, 'dispose')
+    const firstSkeletons = palettes(first)
+    const survivorSkeletons = palettes(survivor)
+    for (const skeleton of [...firstSkeletons, ...survivorSkeletons]) skeleton.computeBoneTexture()
+    const bodyPalette = first.bodySkinned[0].skeleton
+    const bodyTexture = bodyPalette.boneTexture!
+    const textureDispose = vi.fn()
+    bodyTexture.addEventListener('dispose', textureDispose)
+    const inverse = bodyPalette.boneInverses[0].elements.slice()
+
+    expect(disposeActorSkeletons(first.wrapper)).toBe(firstSkeletons.size)
+    expect(dispose).toHaveBeenCalledTimes(firstSkeletons.size)
+    expect(new Set(dispose.mock.contexts)).toEqual(firstSkeletons)
+    expect(textureDispose).toHaveBeenCalledTimes(1)
+    expect(bodyPalette.boneTexture).toBeNull()
+    for (const skeleton of survivorSkeletons) expect(skeleton.boneTexture).not.toBeNull()
+    expect(bodyPalette.boneInverses[0].elements).toEqual(inverse)
+    dispose.mockRestore()
+  }, 60_000)
+})

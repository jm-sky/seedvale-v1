--- /dev/null
+++ b/src/perf/skeletonStats.ts
@@ -0,0 +1,38 @@
+import { Skeleton } from 'three'
+import { peasantBodySkeletons, peasantSkeletonStats } from '../characters/sharePeasantBodySkeleton'
+import { isSkeletonStatsUrlEnabled } from './flags'
+
+let installed = false
+let updates = 0
+let frames = 0
+const windowMarks: Record<string, { updates: number, frames: number }> = {}
+
+/**
+ * `?skelStats=1`: counts executed `Skeleton.update()` calls on eligible Peasant
+ * body skeletons (three runs it once per skeleton per renderer frame) and
+ * exposes `window.__seedvaleSkeletonStats()`. Not a GPU-upload count: a
+ * texture version bump is not proof of an upload.
+ */
+export function installSkeletonStatsIfEnabled(): void {
+  if (installed || !isSkeletonStatsUrlEnabled()) return
+  installed = true
+  const original = Skeleton.prototype.update
+  Skeleton.prototype.update = function patched(this: Skeleton) {
+    if (peasantBodySkeletons.has(this)) updates++
+    original.call(this)
+  }
+  const tick = () => { frames++; requestAnimationFrame(tick) }
+  requestAnimationFrame(tick)
+  // Benchmark window boundaries (`src/perf/benchmark.ts`): snapshot counters at each mark.
+  const originalMark = performance.mark.bind(performance)
+  performance.mark = ((name: string, options?: PerformanceMarkOptions) => {
+    if (name === 'seedvale:bench-window-start' || name === 'seedvale:bench-window-end') windowMarks[name] = { updates, frames }
+    return originalMark(name, options)
+  }) as typeof performance.mark
+  ;(window as unknown as { __seedvaleSkeletonStats?: () => unknown }).__seedvaleSkeletonStats = () => ({
+    ...peasantSkeletonStats,
+    bodySkeletonUpdates: updates,
+    rafFrames: frames,
+    windowMarks,
+  })
+}

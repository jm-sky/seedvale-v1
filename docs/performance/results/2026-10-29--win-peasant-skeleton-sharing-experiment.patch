--- /dev/null
+++ b/src/characters/sharePeasantBodySkeleton.ts
@@ -0,0 +1,161 @@
+/**
+ * Experimental (world-terrain-050, B′): one actor-local `Skeleton` per Peasant
+ * body instead of one per body primitive.
+ *
+ * The shipped Peasant body skins list the same 65 bones in the same order but
+ * carry different inverse-bind matrices that differ by a constant right factor
+ * (`Ipart[j] = Icanonical[j] * Tpart`, verified on every bone). In
+ * `AttachedBindMode` the effective skin operator is
+ * `Mworld⁻¹ · Σ w·BoneWorld[j]·I[j] · Bind`, so swapping the palette for the
+ * canonical one and compensating with `Bind' = Tpart · Bind` preserves skinning.
+ * Geometry, weights, materials and draw submissions are untouched; canonical
+ * inverses are never mutated (they are shared with the loader cache).
+ */
+import { AttachedBindMode, Matrix4, type Object3D, type Skeleton, type SkinnedMesh } from 'three'
+import type { CharacterAppearance } from './characterTypes'
+
+/** Max component error of `Icanonical[j]·T − Ipart[j]`; asset residuals are ≤ 1.4e-7. */
+const FACTOR_TOLERANCE = 1e-5
+
+/** Authored body primitive counts of the verified Peasant bodies. */
+const EXPECTED_BODY_MESHES = { Male: 5, Female: 4 } as const
+
+export type PeasantBodyShareResult = {
+  /** Body meshes considered. */
+  eligible: number
+  skeletonsBefore: number
+  skeletonsAfter: number
+  /** `false` when the original bindings were preserved. */
+  shared: boolean
+  reason?: string
+}
+
+/** Live diagnostic counters (opt-in readers only; plain increments). */
+export type PeasantSkeletonStats = {
+  actors: number
+  eligibleMeshes: number
+  skeletonsBefore: number
+  skeletonsAfter: number
+  failOpen: number
+}
+
+export const peasantSkeletonStats: PeasantSkeletonStats = {
+  actors: 0, eligibleMeshes: 0, skeletonsBefore: 0, skeletonsAfter: 0, failOpen: 0,
+}
+
+/** Skeletons of eligible Peasant bodies (before and after sharing); lets diagnostics count their updates. */
+export const peasantBodySkeletons = new WeakSet<Skeleton>()
+
+/** Only the verified plain Peasant body (not `Peasant_Boots`, professions, legacy models). */
+export function isShareablePeasantBody(kit: Pick<CharacterAppearance, 'sex' | 'outfit'>): boolean {
+  return kit.outfit === 'Peasant'
+}
+
+function distinct(meshes: readonly SkinnedMesh[]): number {
+  return new Set(meshes.map((m) => m.skeleton)).size
+}
+
+/** Experiment arm A: register the bodies for diagnostics only; bindings stay untouched. */
+export function noteUnsharedPeasantBody(meshes: readonly SkinnedMesh[]): void {
+  const count = distinct(meshes)
+  for (const mesh of meshes) peasantBodySkeletons.add(mesh.skeleton)
+  peasantSkeletonStats.actors++
+  peasantSkeletonStats.eligibleMeshes += meshes.length
+  peasantSkeletonStats.skeletonsBefore += count
+  peasantSkeletonStats.skeletonsAfter += count
+}
+
+function usable(matrix: Matrix4): boolean {
+  const det = matrix.determinant()
+  return matrix.elements.every(Number.isFinite) && Number.isFinite(det) && det !== 0
+}
+
+/**
+ * Collapse the body primitives' skeletons into one canonical skeleton when
+ * every compatibility condition holds; otherwise leave all bindings as they
+ * were. All-or-nothing per actor; idempotent.
+ *
+ * Call after the final clone/assembly of the actor, before bounds installation.
+ * Never share the result between actors: the canonical skeleton belongs to the
+ * bones of the meshes passed in.
+ */
+export function sharePeasantBodySkeleton(
+  sex: keyof typeof EXPECTED_BODY_MESHES,
+  meshes: readonly SkinnedMesh[],
+): PeasantBodyShareResult {
+  const before = distinct(meshes)
+  const result: PeasantBodyShareResult = {
+    eligible: meshes.length, skeletonsBefore: before, skeletonsAfter: before, shared: false,
+  }
+  const fail = (reason: string): PeasantBodyShareResult => {
+    peasantSkeletonStats.failOpen++
+    return { ...result, reason }
+  }
+  for (const mesh of meshes) peasantBodySkeletons.add(mesh.skeleton)
+  peasantSkeletonStats.actors++
+  peasantSkeletonStats.eligibleMeshes += meshes.length
+  peasantSkeletonStats.skeletonsBefore += before
+
+  const done = (r: PeasantBodyShareResult): PeasantBodyShareResult => {
+    peasantSkeletonStats.skeletonsAfter += r.skeletonsAfter
+    return r
+  }
+
+  if (meshes.length !== EXPECTED_BODY_MESHES[sex]) return done(fail('unexpected body mesh count'))
+  if (meshes.some((m) => !m.isSkinnedMesh)) return done(fail('not skinned'))
+  if (meshes.some((m) => m.bindMode !== AttachedBindMode)) return done(fail('not attached bind mode'))
+  if (before === 1) return done({ ...result, shared: true })
+
+  const canonical = meshes[0].skeleton
+  const bones = canonical.bones
+  if (bones.length === 0 || bones.some((b) => !b)) return done(fail('missing bones'))
+  for (const mesh of meshes) {
+    const other = mesh.skeleton.bones
+    if (other.length !== bones.length || other.some((b, i) => b !== bones[i])) {
+      return done(fail('bone references differ'))
+    }
+    if (mesh.skeleton.boneInverses.length !== bones.length) return done(fail('missing inverse binds'))
+    if (!usable(mesh.bindMatrix) || !usable(mesh.matrixWorld)) return done(fail('degenerate mesh matrix'))
+  }
+  if (!canonical.boneInverses.every(usable)) return done(fail('degenerate inverse bind'))
+
+  // Plan every rebinding before touching any mesh.
+  const canonicalInverse0 = canonical.boneInverses[0].clone().invert()
+  const plans: { mesh: SkinnedMesh, bind: Matrix4 }[] = []
+  const factor = new Matrix4()
+  const probe = new Matrix4()
+  for (const mesh of meshes) {
+    if (mesh.skeleton === canonical) continue
+    const inverses = mesh.skeleton.boneInverses
+    if (!inverses.every(usable)) return done(fail('degenerate inverse bind'))
+    factor.multiplyMatrices(canonicalInverse0, inverses[0])
+    if (!usable(factor)) return done(fail('degenerate factor'))
+    for (let j = 0; j < bones.length; j++) {
+      probe.multiplyMatrices(canonical.boneInverses[j], factor)
+      const a = probe.elements
+      const b = inverses[j].elements
+      for (let k = 0; k < 16; k++) {
+        if (!(Math.abs(a[k] - b[k]) <= FACTOR_TOLERANCE)) return done(fail('inverse binds not related by a constant factor'))
+      }
+    }
+    plans.push({ mesh, bind: new Matrix4().multiplyMatrices(factor, mesh.bindMatrix) })
+  }
+
+  for (const { mesh, bind } of plans) mesh.bind(canonical, bind)
+  return done({ ...result, skeletonsAfter: distinct(meshes), shared: true })
+}
+
+/**
+ * Dispose every palette (bone texture) owned by an actor's skinned meshes,
+ * once per distinct skeleton. Skeletons are actor-local clones, never loader
+ * cache resources; geometry/materials stay with `disposeObject3D`.
+ */
+export function disposeActorSkeletons(root: Object3D): number {
+  const seen = new Set<Skeleton>()
+  root.traverse((o) => {
+    const mesh = o as SkinnedMesh
+    if (mesh.isSkinnedMesh && mesh.skeleton) seen.add(mesh.skeleton)
+  })
+  for (const skeleton of seen) skeleton.dispose()
+  return seen.size
+}
